<?xml version="1.0" encoding="utf-8"?>
<!-- Saves and settings may be backed up by Android; caches and downloads in progress are not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="staging" />
        <exclude domain="file" path="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="staging" />
    </device-transfer>
</data-extraction-rules>
