{
  "schema_version": 1,
  "profile_id": "berk-tetris.v1",
  "title": "Tetris (berk76)",
  "help": "Start picks Tetris from the menu (the keyboard picks Addtris or X-Tris). Left and right slide, Up rotates, Down drops the piece.",
  "orientation": "portrait",
  "actions": [
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "rotate",
      "label": "Rotate",
      "icon": "rotate",
      "output": {
        "key": "UP"
      }
    },
    {
      "id": "drop",
      "label": "Drop",
      "icon": "drop",
      "output": {
        "key": "DOWN"
      },
      "haptic": "click"
    },
    {
      "id": "start",
      "label": "Start",
      "icon": "play",
      "output": {
        "text": "2"
      }
    },
    {
      "id": "pause",
      "label": "Pause",
      "icon": "pause",
      "output": {
        "text": "p"
      },
      "states": [
        {
          "when": "(?i)\\bpaused\\b",
          "label": "Resume",
          "icon": "play",
          "output": {
            "key": "ENTER"
          }
        }
      ]
    },
    {
      "id": "help",
      "label": "Help",
      "icon": "info",
      "output": {
        "text": "h"
      }
    },
    {
      "id": "quit",
      "label": "Quit",
      "icon": "close",
      "output": {
        "text": "q"
      },
      "confirm": true
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "rotate",
          "down": "drop",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 96,
        "bind": {
          "press": "drop"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 60,
        "bind": {
          "press": "pause"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "start"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "rotate",
          "down": "drop",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 92,
        "bind": {
          "press": "drop"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 56,
        "bind": {
          "press": "pause"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "start"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": true
}
