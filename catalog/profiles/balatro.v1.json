{
  "schema_version": 1,
  "profile_id": "balatro.v1",
  "title": "Poker hands",
  "help": "Move along your hand and pick cards with the pad. Play scores the picked cards, Discard swaps them for new ones.",
  "orientation": "landscape",
  "actions": [
    {
      "id": "up",
      "label": "Up",
      "icon": "arrow_up",
      "output": {
        "key": "UP"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "down",
      "label": "Down",
      "icon": "arrow_down",
      "output": {
        "key": "DOWN"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "play",
      "label": "Play",
      "icon": "check",
      "output": {
        "key": "ENTER"
      },
      "haptic": "click"
    },
    {
      "id": "discard",
      "label": "Discard",
      "icon": "refresh",
      "output": {
        "text": "x"
      }
    },
    {
      "id": "quit",
      "label": "Quit",
      "icon": "close",
      "output": {
        "text": "q"
      },
      "confirm": true
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 88,
        "bind": {
          "press": "play"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 64,
        "bind": {
          "press": "discard"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "quit"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 88,
        "bind": {
          "press": "play"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 60,
        "bind": {
          "press": "discard"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "quit"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": true
}
