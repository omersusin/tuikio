{
  "schema_version": 1,
  "profile_id": "csol.v1",
  "title": "Solitaire",
  "help": "Move with the pad. Select picks up a card (twice sends it home), Move puts it under the cursor, Stock deals, Auto sends what it can to the foundations. R starts a new game.",
  "orientation": "landscape",
  "actions": [
    {
      "id": "up",
      "label": "Up",
      "icon": "arrow_up",
      "output": {
        "key": "UP"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "down",
      "label": "Down",
      "icon": "arrow_down",
      "output": {
        "key": "DOWN"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "select",
      "label": "Select",
      "icon": "check",
      "output": {
        "text": " "
      }
    },
    {
      "id": "move",
      "label": "Move",
      "icon": "arrow_down",
      "output": {
        "key": "ENTER"
      }
    },
    {
      "id": "stock",
      "label": "Stock",
      "icon": "refresh",
      "output": {
        "text": "s"
      }
    },
    {
      "id": "auto",
      "label": "Auto",
      "icon": "spark",
      "output": {
        "text": "a"
      }
    },
    {
      "id": "quit",
      "label": "Quit",
      "icon": "close",
      "output": {
        "text": "q"
      },
      "confirm": true
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 84,
        "bind": {
          "press": "select"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 60,
        "bind": {
          "press": "move"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "stock"
        }
      },
      {
        "type": "button",
        "anchor": "top_start",
        "size": 52,
        "bind": {
          "press": "auto"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 80,
        "bind": {
          "press": "select"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 56,
        "bind": {
          "press": "move"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "stock"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_start",
        "size": 52,
        "bind": {
          "press": "auto"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": true
}
