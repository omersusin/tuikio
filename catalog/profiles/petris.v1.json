{
  "schema_version": 1,
  "profile_id": "petris.v1",
  "title": "Petris keys",
  "help": "Left and right slide the piece, up rotates clockwise and Space counter-clockwise; the big button drops it.",
  "orientation": "portrait",
  "actions": [
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 170,
        "interval_ms": 55
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 170,
        "interval_ms": 55
      }
    },
    {
      "id": "rotate",
      "label": "Rotate",
      "icon": "rotate",
      "output": {
        "key": "UP"
      }
    },
    {
      "id": "ccw",
      "label": "Turn back",
      "output": {
        "text": " "
      }
    },
    {
      "id": "drop",
      "label": "Drop",
      "icon": "drop",
      "output": {
        "key": "DOWN"
      },
      "haptic": "heavy"
    },
    {
      "id": "ok",
      "label": "OK",
      "output": {
        "key": "ENTER"
      }
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "rotate",
          "down": "drop",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 92,
        "bind": {
          "press": "drop"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 60,
        "bind": {
          "press": "ccw"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "ok"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "rotate",
          "down": "drop",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 88,
        "bind": {
          "press": "drop"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 56,
        "bind": {
          "press": "ccw"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "ok"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": false
}
