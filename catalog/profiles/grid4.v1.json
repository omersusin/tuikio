{
  "schema_version": 1,
  "profile_id": "grid4.v1",
  "title": "Slide the grid",
  "help": "Swipe anywhere on the board or use the pad. Every move slides all tiles.",
  "orientation": "portrait",
  "actions": [
    {"id": "up", "label": "Up", "icon": "arrow_up", "output": {"key": "UP"}},
    {"id": "down", "label": "Down", "icon": "arrow_down", "output": {"key": "DOWN"}},
    {"id": "left", "label": "Left", "icon": "arrow_left", "output": {"key": "LEFT"}},
    {"id": "right", "label": "Right", "icon": "arrow_right", "output": {"key": "RIGHT"}},
    {"id": "restart", "label": "New game", "icon": "refresh", "output": {"sequence": [{"text": "r"}, {"text": "y"}]}, "confirm": true},
    {"id": "quit", "label": "Quit", "icon": "close", "output": {"sequence": [{"text": "q"}, {"text": "y"}]}, "confirm": true}
  ],
  "layout": {
    "portrait": [
      {"type": "dpad4", "anchor": "bottom_center", "size": 208, "bind": {"up": "up", "down": "down", "left": "left", "right": "right"}},
      {"type": "button", "anchor": "bottom_start", "size": 64, "bind": {"press": "restart"}},
      {"type": "button", "anchor": "bottom_end", "size": 64, "bind": {"press": "quit"}}
    ],
    "landscape": [
      {"type": "dpad4", "anchor": "center_start", "size": 180, "bind": {"up": "up", "down": "down", "left": "left", "right": "right"}},
      {"type": "button", "anchor": "top_end", "size": 60, "bind": {"press": "restart"}},
      {"type": "button", "anchor": "bottom_end", "size": 60, "bind": {"press": "quit"}}
    ]
  },
  "gestures": {"swipe_up": "up", "swipe_down": "down", "swipe_left": "left", "swipe_right": "right"},
  "pointer": "none",
  "keyboard": true
}
