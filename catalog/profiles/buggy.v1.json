{
  "schema_version": 1,
  "profile_id": "buggy.v1",
  "title": "Jump and fire",
  "help": "Jump over craters with the big button, laser the meteors with Fire. Start begins a new run.",
  "orientation": "landscape",
  "actions": [
    {"id": "jump", "label": "Jump", "icon": "arrow_up", "output": {"text": " "}, "haptic": "click"},
    {"id": "fire", "label": "Fire", "icon": "spark", "output": {"text": "a"}, "repeat": {"delay_ms": 250, "interval_ms": 150}},
    {"id": "start", "label": "Start", "icon": "play", "output": {"text": "y"}},
    {"id": "scores", "label": "Scores", "output": {"text": "s"}},
    {"id": "quit", "label": "Quit", "icon": "close", "output": {"text": "q"}, "confirm": true}
  ],
  "layout": {
    "portrait": [
      {"type": "button", "anchor": "bottom_end", "size": 108, "bind": {"press": "jump"}, "style": "primary"},
      {"type": "button", "anchor": "bottom_start", "size": 92, "bind": {"press": "fire"}},
      {"type": "button", "anchor": "top_start", "size": 56, "bind": {"press": "start"}},
      {"type": "button", "anchor": "top_end", "size": 52, "bind": {"press": "quit"}}
    ],
    "landscape": [
      {"type": "button", "anchor": "center_end", "size": 104, "bind": {"press": "jump"}, "style": "primary"},
      {"type": "button", "anchor": "center_start", "size": 88, "bind": {"press": "fire"}},
      {"type": "button", "anchor": "bottom_start", "size": 56, "bind": {"press": "start"}},
      {"type": "button", "anchor": "top_end", "size": 52, "bind": {"press": "quit"}}
    ]
  },
  "gestures": {"swipe_up": "jump"},
  "pointer": "none",
  "keyboard": true
}
