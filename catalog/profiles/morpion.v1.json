{
  "schema_version": 1,
  "profile_id": "morpion.v1",
  "title": "Morpion",
  "help": "Move the cursor with the pad and Select a point; pick a line the same way. Undo takes back a move, Cancel backs out, Help shows the possible lines.",
  "orientation": "portrait",
  "actions": [
    {
      "id": "up",
      "label": "Up",
      "icon": "arrow_up",
      "output": {
        "key": "UP"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "down",
      "label": "Down",
      "icon": "arrow_down",
      "output": {
        "key": "DOWN"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "select",
      "label": "Select",
      "icon": "check",
      "output": {
        "text": " "
      }
    },
    {
      "id": "undo",
      "label": "Undo",
      "icon": "back",
      "output": {
        "key": "BACKSPACE"
      }
    },
    {
      "id": "cancel",
      "label": "Cancel",
      "icon": "close",
      "output": {
        "key": "ESCAPE"
      }
    },
    {
      "id": "help",
      "label": "Help",
      "icon": "info",
      "output": {
        "text": "h"
      }
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 84,
        "bind": {
          "press": "select"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 60,
        "bind": {
          "press": "undo"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "cancel"
        }
      },
      {
        "type": "button",
        "anchor": "top_start",
        "size": 52,
        "bind": {
          "press": "help"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 80,
        "bind": {
          "press": "select"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 56,
        "bind": {
          "press": "undo"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "cancel"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_start",
        "size": 52,
        "bind": {
          "press": "help"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": true
}
