{
  "schema_version": 1,
  "profile_id": "qsd-blocks.v1",
  "title": "Blocks (Q S D)",
  "help": "Left and right slide the piece, Rotate turns it, Down speeds it up.",
  "orientation": "portrait",
  "actions": [
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "text": "q"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "text": "d"
      },
      "repeat": {
        "delay_ms": 300,
        "interval_ms": 110
      }
    },
    {
      "id": "rotate",
      "label": "Rotate",
      "icon": "rotate",
      "output": {
        "text": " "
      }
    },
    {
      "id": "soft",
      "label": "Down",
      "icon": "arrow_down",
      "output": {
        "text": "s"
      },
      "repeat": {
        "delay_ms": 90,
        "interval_ms": 40
      }
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "rotate",
          "down": "soft",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 96,
        "bind": {
          "press": "rotate"
        },
        "style": "primary"
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "rotate",
          "down": "soft",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 92,
        "bind": {
          "press": "rotate"
        },
        "style": "primary"
      }
    ]
  },
  "pointer": "none",
  "keyboard": false
}
